# RainbowLens — configuración de ejemplo para desarrollo local.
# Copia este archivo como .env y completa tus credenciales.

# Aplicación: rainbowlens-dash → http://127.0.0.1:5001
APP_ENV=local
LOCAL_MODE=true
DASH_HOST=127.0.0.1
DASH_PORT=5001
LOG_LEVEL=INFO

# En local, si SECRET_KEY está vacío, se genera una clave temporal al arrancar.
SECRET_KEY=

# PostgreSQL: cuentas y datos relacionales.
# Si DATABASE_URL tiene valor, tiene prioridad sobre los campos POSTGRES_* de conexión.
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=proyecto_lgbti_relacional
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSL_MODE=prefer
DB_CONNECT_TIMEOUT_SECONDS=3
POSTGRES_POOL_MAX_SIZE=6
POSTGRES_POOL_MAX_IDLE_SECONDS=60
POSTGRES_POOL_WAIT_TIMEOUT_SECONDS=3

# MongoDB: datos analíticos y estado de seguridad.
# Si MONGO_URI tiene valor, tiene prioridad sobre host, puerto, credenciales y MONGO_TLS.
# MONGO_DB permite seleccionar la base de datos también cuando se utiliza una URI.
MONGO_URI=
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=proyecto_lgbti_no_relacional
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_TLS=false
MONGO_ENSURE_INDEXES_ON_STARTUP=true
MONGO_SERVER_SELECTION_TIMEOUT_MS=2500
MONGO_SOCKET_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=12
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_WAIT_QUEUE_TIMEOUT_MS=2000

# Supabase Storage: Para archivos FELGTBI y presentaciones docentes.
# Completa con la URL y las credenciales S3 de TU proyecto para usar esas funciones.
# URL de ejemplo: https://tu-proyecto.supabase.co
# Endpoint S3 de ejemplo: https://tu-proyecto.storage.supabase.co/storage/v1/s3
SUPABASE_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=us-east-1
SUPABASE_STORAGE_BUCKET=felgtbi-reports
DIDACTIC_SLIDES_BUCKET=slideshow-didactics
DIDACTIC_SLIDES_BUCKET_PUBLIC=true
SUPABASE_CONNECT_TIMEOUT_SECONDS=3
SUPABASE_READ_TIMEOUT_SECONDS=10

# Caché en memoria: valores predeterminados del desarrollo local, tamaños en bytes.
CACHE_VERSION=v1
CACHE_DEFAULT_TIMEOUT=300
LOCAL_CACHE_MAX_ENTRIES=512
LOCAL_CACHE_MAX_VALUE_BYTES=4194304
LOCAL_CACHE_MAX_TOTAL_BYTES=67108864
ANALYTICS_CACHE_TIMEOUT_SECONDS=3600
ANALYTICS_HEALTH_CHECK_TTL_SECONDS=15
SPAIN_COLLECTIONS_CACHE_TIMEOUT_SECONDS=300
HTTP_GZIP_MIN_BYTES=1024

# Límites de acceso y carga de archivos. Los tamaños *_MB se expresan en MiB.
AUTH_MAX_ATTEMPTS=6
AUTH_WINDOW_SECONDS=300
RATE_LIMIT_LOCAL_MAX_KEYS=10000
UPLOAD_MAX_FILE_MB=20
UPLOAD_MAX_TOTAL_MB=30
UPLOAD_MAX_REQUEST_MB=90
UPLOAD_MAX_ATTEMPTS=10
UPLOAD_WINDOW_SECONDS=3600
PDF_FIGURE_MAX_PIXELS=2500000
PDF_MAX_PAGES=500
FELGTBI_SCRAPER_MAX_RESPONSE_MB=20
REPORT_PREVIEW_MAX_ATTEMPTS=30
REPORT_DOWNLOAD_MAX_ATTEMPTS=10
REPORT_RATE_WINDOW_SECONDS=3600
